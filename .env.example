# OpenRouter（用于编排层 LLM 生成推荐与解释）
# 在项目根目录复制为 .env 并填入你的 Key：cp .env.example .env
OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_RECIPE_MODEL=openai/gpt-4o
#
# Render 部署建议：
# LIGHTTABLE_DATA_DIR=/var/data/lighttable
#
# 默认只允许本地前端跨域；如果你有额外客户端，再按需填写逗号分隔域名。
# LIGHTTABLE_CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
#
# 对高成本接口的服务端限流，防止公开站点被脚本滥刷。
# LIGHTTABLE_ENABLE_RATE_LIMIT=1
# LIGHTTABLE_RATE_LIMIT_RECOMMEND_PER_HOUR=30
# LIGHTTABLE_RATE_LIMIT_RECOGNIZE_PER_HOUR=12
# LIGHTTABLE_RATE_LIMIT_PARSE_TEXT_PER_HOUR=120
# LIGHTTABLE_RATE_LIMIT_LLM_TEST_PER_HOUR=5
